{
  "name": "duoquest",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:migrate": "pnpm --filter @duoquest/api prisma migrate dev",
    "db:push": "pnpm --filter @duoquest/api prisma db push",
    "db:generate": "pnpm --filter @duoquest/api prisma generate",
    "db:studio": "pnpm --filter @duoquest/api prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
